<?xml version="1.0"?>
<!-- Line length limit, used by every sniff that checks or wraps long lines. XML can't do arithmetic, so the "plus one"
     value is for sniffs whose threshold is the first length that's too long. -->
<!DOCTYPE ruleset [
    <!ENTITY lineLength "120">
    <!ENTITY lineLengthPlusOne "121">
]>
<ruleset name="Jumbo">
    <description>Jumbo Coding Standard</description>

    <!-- ====== PERCS31 ====== -->

    <!-- PER Coding Style 3.1, on PSR-12. Everything below is an extra rule. -->
    <rule ref="PERCS31">
        <!-- Zend.Files.ClosingTag, below, reports the same closing tags, and more -->
        <exclude name="PSR2.Files.ClosingTag"/>
    </rule>

    <!-- ====== GENERAL (2) ====== -->

    <!-- Line length: PERCS31's warning over the limit, which is the sniff's absoluteLineLimit there, and its
         severity 4 warning over 80 -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="absoluteLineLimit" value="&lineLength;"/>
        </properties>
    </rule>

    <rule ref="SlevomatCodingStandard.PHP.UselessSemicolon"/>

    <!-- No invisible or non-printable character but a space and a line feed, such as a tab, a no-break or zero-width
         space, or a bidirectional control ("Trojan Source"). In a string, it's fixed to an escape. -->
    <rule ref="Jumbo.PHP.DisallowInvisibleCharacters"/>

    <!-- A warning for a merge conflict marker left in a comment, heredoc, nowdoc or inline HTML, where PHP accepts it -->
    <rule ref="Generic.VersionControl.GitMergeConflict"/>

    <!-- No executable PHP file -->
    <rule ref="Generic.Files.ExecutableFile"/>

    <!-- A warning for a class, interface, trait or enum name declared twice in the files checked -->
    <rule ref="Generic.Classes.DuplicateClassName"/>

    <!-- No more than one blank line in a row, anywhere in PHP code. PERCS31 allows any number, as PER 2.3 does. -->
    <rule ref="PhpCollective.WhiteSpace.EmptyLines"/>

    <!-- No blank line straight after the opening brace of a function, method or closure. PER only rules one out before
         the closing brace (4.4, 7), which PSR2.Methods.FunctionClosingBrace reports. -->
    <rule ref="Squiz.WhiteSpace.FunctionOpeningBraceSpace.SpacingAfter"/>

    <!-- One constant per statement, and one space after const, for a global const too. PERCS31 only checks a class's
         constants, as section 4 is about classes. -->
    <rule ref="PERCS31.Classes.ConstantDeclaration">
        <properties>
            <property name="checkGlobalConstants" value="true"/>
        </properties>
    </rule>

    <!-- No blank line straight before the closing parenthesis of a parameter list, a closure's use list or an argument
         list, so no multi-line list starts or ends with one. PERCS31 excludes these codes, as PER has no rule for
         either. -->
    <rule ref="PERCS31.Functions.MultiLineFunctionDeclaration.BlankLineBeforeCloseBracket">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.Functions.FunctionCallLayout.BlankLineBeforeCloseBracket">
        <severity>5</severity>
    </rule>

    <!-- No blank line in a trait's conflict block. PERCS31 excludes this code, as PER only shows the block with none. -->
    <rule ref="PERCS31.Classes.TraitUseBlock.BlankLine">
        <severity>5</severity>
    </rule>

    <!-- No blank line straight before the closing parenthesis of a split control structure header. PERCS31 excludes
         this code, as PER only puts the ) and the { together on their own line. -->
    <rule ref="PERCS31.ControlStructures.ControlStructureSpacing.BlankLineBeforeCloseParenthesis">
        <severity>5</severity>
    </rule>

    <!-- No blank line after a case or default label. The parent's codes report that, and a statement on the label's
         line, so the code PERCS31 uses for the statement alone is turned off. -->
    <rule ref="PERCS31.ControlStructures.SwitchDeclaration.BodyOnNextLineCASE">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.ControlStructures.SwitchDeclaration.BodyOnNextLineDEFAULT">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.ControlStructures.SwitchDeclaration.StatementOnLabelLine">
        <severity>0</severity>
    </rule>

    <!-- No blank line between trait use statements. PERCS31 excludes this code, as PER only requires a blank line after
         the last (4.2). PhpCollective.WhiteSpace.EmptyLines allows no more than one there. -->
    <rule ref="PERCS31.Classes.TraitUseBlock.BlankLineBetweenUses">
        <severity>5</severity>
    </rule>

    <!-- No blank line straight after the opening brace, or straight before the closing brace, of a block declare, a
         property's hook list or a hook's body. PER has no rule for either, so PERCS31 allows them. -->
    <rule ref="Jumbo.WhiteSpace.BlockBlankLines"/>

    <!-- A comment on its own line is indented as a statement would be. PERCS31 doesn't check a comment's indent, as PER
         has no rule for it. A docblock's isn't checked here either. -->
    <rule ref="PERCS31.WhiteSpace.ScopeIndent">
        <properties>
            <property name="ignoreIndentationTokens" type="array">
                <element value="T_DOC_COMMENT_OPEN_TAG"/>
            </property>
        </properties>
    </rule>
    <rule ref="PERCS31.WhiteSpace.ConsistentIndent">
        <properties>
            <property name="checkComments" value="true"/>
        </properties>
    </rule>

    <!-- No run of spaces in code, as a safety net for the sniffs that check each construct's spacing. Aligned text in a
         comment or docblock is allowed. -->
    <rule ref="SlevomatCodingStandard.Whitespaces.DuplicateSpaces">
        <properties>
            <property name="ignoreSpacesInComment" value="true"/>
            <property name="ignoreSpacesInAnnotation" value="true"/>
        </properties>
    </rule>

    <!-- No white space before a semicolon, including a line break. In a for header,
         Squiz.ControlStructures.ForLoopDeclaration reports the same space, and both fixes agree. -->
    <rule ref="Squiz.WhiteSpace.SemicolonSpacing"/>

    <!-- No space inside grouping parentheses, as in ($a + $b) * 2. A line break is left to
         Jumbo.Formatting.ExpressionFormat and PERCS31.Operators.OperatorPlacement. -->
    <rule ref="Generic.WhiteSpace.ArbitraryParenthesesSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
        </properties>
    </rule>

    <!-- ====== TYPES (2.5) ====== -->

    <!-- Magic constants in upper case, as in __DIR__. PHP ignores their case, and PERCS31 doesn't check it, as 2.5's
         rule on keywords isn't read as covering them. -->
    <rule ref="Universal.Constants.UppercaseMagicConstants"/>

    <!-- true, false and null, not \true, \false and \null -->
    <rule ref="Universal.PHP.NoFQNTrueFalseNull"/>

    <!-- The Jumbo versions of ParameterTypeHintSpacing and ParameterTypeHint, which skip a function with a hook on a
         promoted constructor parameter, as the parents read the variables in the hook as parameters -->
    <rule ref="Jumbo.TypeHints.ParameterTypeHintSpacing"/>
    <!-- A @param, @return or @var that only repeats the native type, with no description, is removed -->
    <rule ref="Jumbo.TypeHints.ParameterTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHintSpacing"/>
    <!-- ?T for a nullable type is an error here, not PERCS31's warning -->
    <rule ref="PERCS31.TypeHints.CompoundType.ShortNullable">
        <type>error</type>
    </rule>

    <!-- The types in each union and intersection sorted, and no repeated or redundant type in a doc comment, such as
         true beside bool. PER has no rule for either. -->
    <rule ref="PERCS31.TypeHints.CompoundType">
        <properties>
            <property name="sortTypes" value="true"/>
            <property name="checkRedundantTypes" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.NullableTypeForNullDefaultValue"/>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ClassConstantTypeHint"/>

    <!-- Docblock types: array<int>, not int[] -->
    <rule ref="SlevomatCodingStandard.TypeHints.DisallowArrayTypeHintSyntax"/>

    <!-- ====== FILES AND NAMESPACES (3) ====== -->

    <!-- No closing tag at the end of a file, including one that mixes PHP and HTML, which PSR2.Files.ClosingTag
         allows -->
    <rule ref="Zend.Files.ClosingTag"/>

    <!-- A multi-line PHP block in a file with markup: its tags on their own lines, level with its code, and no multi-line
         short echo tag. A tag on one line is exempt. PERCS31 also allows the code one level past the tags. -->
    <rule ref="Jumbo.PHP.EmbeddedPhp"/>

    <!-- One statement in a short echo tag; a tag with more becomes <?php echo -->
    <rule ref="Universal.PHP.OneStatementInShortEchoTag"/>

    <!-- Functions and OO structures (classes, interfaces, traits and enums) in separate files -->
    <rule ref="Universal.Files.SeparateFunctionsFromOO"/>

    <!-- declare(strict_types=1) in every file -->
    <rule ref="Jumbo.TypeHints.DeclareStrictTypes"/>

    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>
    <!-- Slevomat's namespace sniffs skip a compound namespace, so it would hide unused and unsorted imports -->
    <rule ref="SlevomatCodingStandard.Namespaces.DisallowGroupUse"/>
    <rule ref="SlevomatCodingStandard.Namespaces.MultipleUsesPerLine"/>
    <rule ref="SlevomatCodingStandard.Namespaces.NamespaceDeclaration"/>
    <rule ref="SlevomatCodingStandard.Namespaces.ReferenceUsedNamesOnly"/>
    <rule ref="SlevomatCodingStandard.Namespaces.RequireOneNamespaceInFile"/>
    <!-- Replaced by Jumbo.Namespaces.UnusedUses, which waits while a use keyword is miscased (Slevomat bug) -->
    <rule ref="Jumbo.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.UseFromSameNamespace"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UselessAlias"/>

    <!-- A file named after the class, interface, trait or enum it declares, so the autoloader can find it -->
    <rule ref="Squiz.Classes.ClassFileName"/>

    <!-- ====== CLASSES, PROPERTIES AND CONSTANTS (4) ====== -->

    <rule ref="SlevomatCodingStandard.Classes.ClassMemberSpacing"/>
    <!-- The Jumbo versions of ConstantSpacing, EnumCaseSpacing and PropertySpacing, which skip a member on a file's
         last line, as the parents crash the whole run on one -->
    <rule ref="Jumbo.Classes.ConstantSpacing">
        <properties>
            <property name="minLinesCountBeforeWithoutComment" value="1"/>
        </properties>
        <exclude name="Jumbo.Classes.ConstantSpacing.IncorrectCountOfBlankLinesAfterConstant"/>
    </rule>
    <rule ref="Jumbo.Classes.EnumCaseSpacing">
        <properties>
            <property name="minLinesCountBeforeWithoutComment" value="1"/>
        </properties>
    </rule>
    <rule ref="Jumbo.Classes.PropertySpacing">
        <properties>
            <property name="minLinesCountBeforeWithoutComment" value="1"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.DisallowStringExpressionPropertyFetch"/>
    <!-- Replaced by Jumbo.Classes.EmptyLinesAroundClassBraces, which allows an empty body as {} -->
    <rule ref="Jumbo.Classes.EmptyLinesAroundClassBraces">
        <properties>
            <property name="linesCountAfterOpeningBrace" value="0"/>
            <property name="linesCountBeforeClosingBrace" value="0"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Classes.MethodSpacing"/>
    <rule ref="SlevomatCodingStandard.Classes.ModernClassNameReference"/>
    <rule ref="SlevomatCodingStandard.Classes.RequireSelfReference"/>
    <rule ref="SlevomatCodingStandard.Classes.ReadonlyClass"/>
    <rule ref="SlevomatCodingStandard.Classes.RequireConstructorPropertyPromotion"/>

    <!-- Trait use statements in alphabetical order, and a class's extends and implements lists too -->
    <rule ref="SlevomatCodingStandard.Classes.TraitUseOrder"/>
    <rule ref="Universal.OOStructures.AlphabeticExtendsImplements"/>

    <!-- A warning for a method that only calls its parent, and for final on a method of a final class -->
    <rule ref="Generic.CodeAnalysis.UselessOverridingMethod"/>
    <rule ref="Generic.CodeAnalysis.UnnecessaryFinalModifier"/>

    <!-- A warning for returning a value from a constructor or destructor -->
    <rule ref="Universal.CodeAnalysis.ConstructorDestructorReturn.ReturnValueFound"/>

    <!-- No $this in a static method -->
    <rule ref="Squiz.Scope.StaticThisUsage"/>

    <rule ref="SlevomatCodingStandard.Classes.ClassLength">
        <properties>
            <property name="maxLinesLength" value="1000"/>
        </properties>
    </rule>

    <!-- self, not static, in a final class. Not for a return type: on PHP 8.4, self can't replace a static return
         type that a parent declares, so the fix would cause a fatal error. -->
    <rule ref="Universal.CodeAnalysis.StaticInFinalClass">
        <exclude name="Universal.CodeAnalysis.StaticInFinalClass.ReturnType"/>
    </rule>

    <!-- Global constants in UPPER_CASE too, with no leading underscore, and every constant in upper case in strict
         UPPER_SNAKE_CASE, none of which PER requires -->
    <rule ref="PERCS31.NamingConventions.ValidConstantName">
        <properties>
            <property name="checkGlobalConstants" value="true"/>
            <property name="requireUpperSnakeCase" value="true"/>
        </properties>
    </rule>

    <!-- UPPER_CASE is preferred for every constant, so bury the warning recommending PascalCase for enum constants -->
    <rule ref="PERCS31.NamingConventions.ValidConstantName.EnumConstantNotPascalCase">
        <severity>4</severity>
    </rule>

    <!-- ====== FUNCTIONS AND CALLS (4.7) ====== -->

    <rule ref="SlevomatCodingStandard.Classes.RequireMultiLineMethodSignature">
        <properties>
            <property name="minLineLength" value="&lineLengthPlusOne;"/>
        </properties>
    </rule>
    <!-- The Jumbo version of RequireSingleLineMethodSignature, which skips a method with a hook on a promoted
         constructor parameter, as the parent's fix breaks it -->
    <rule ref="Jumbo.Classes.RequireSingleLineMethodSignature">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.FunctionLength">
        <properties>
            <property name="maxLinesLength" value="100"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.RequireMultiLineCall">
        <properties>
            <property name="minLineLength" value="&lineLengthPlusOne;"/>
        </properties>
    </rule>
    <!-- The Jumbo version of SlevomatCodingStandard.Functions.RequireSingleLineCall, which skips a call with an
         anonymous class or match argument, as the parent's fix puts the body on one line -->
    <rule ref="Jumbo.Functions.RequireSingleLineCall">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Functions.StrictCall"/>
    <rule ref="SlevomatCodingStandard.Functions.UselessParameterDefaultValue"/>
    <rule ref="SlevomatCodingStandard.PHP.DisallowDirectMagicInvokeCall"/>

    <!-- A warning for an unused parameter, except in a class that extends a class or implements an interface, where a
         parent or the interface may fix the signature, and before a used parameter, where it can't be dropped -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundBeforeLastUsed"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClass"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClassBeforeLastUsed"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInExtendedClassAfterLastUsed"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterface"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceBeforeLastUsed"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundInImplementedInterfaceAfterLastUsed"/>
    </rule>

    <!-- A warning for blocks nested more than 5 deep in a function, and an error for more than 10 -->
    <rule ref="Generic.Metrics.NestingLevel"/>

    <!-- No call to a native function that PHP marks deprecated, going by the PHP that runs phpcs -->
    <rule ref="Generic.PHP.DeprecatedFunctions"/>

    <!-- A warning for eval() -->
    <rule ref="Squiz.PHP.Eval"/>

    <!-- No function alias, such as sizeof() or join() -->
    <rule ref="PhpCollective.PHP.RemoveFunctionAlias"/>

    <!-- No extract(), which creates variables from an array's keys -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="extract" value="null"/>
            </property>
        </properties>
    </rule>

    <!-- A global function's name in camelCase, without a leading __. A method's name is checked by PSR1. -->
    <rule ref="Squiz.NamingConventions.ValidFunctionName.NotCamelCaps"/>
    <rule ref="Squiz.NamingConventions.ValidFunctionName.DoubleUnderscore"/>

    <!-- A native function's name in lower case, and no function declared inside another -->
    <rule ref="Squiz.PHP.LowercasePHPFunctions"/>
    <rule ref="Squiz.PHP.InnerFunctions"/>

    <!-- No global statement -->
    <rule ref="Squiz.PHP.GlobalKeyword"/>

    <!-- A cast, not strval(), intval(), floatval() or boolval(), and $x === null, not is_null($x) -->
    <rule ref="PhpCollective.PHP.PreferCastOverFunction"/>
    <rule ref="PhpCollective.PHP.NoIsNull"/>

    <!-- printf(), not echo sprintf(), and __DIR__ or dirname()'s levels argument, not dirname(__FILE__) or nested
         dirname() calls -->
    <rule ref="Universal.CodeAnalysis.NoEchoSprintf"/>
    <rule ref="Modernize.FunctionCalls.Dirname"/>

    <!-- ====== CONTROL STRUCTURES (5) ====== -->

    <!-- Every empty body as {}, as an error, including a control structure's. PERCS31 warns for a class or function,
         where PER says SHOULD, and doesn't check a control structure, where PER says nothing. -->
    <rule ref="PERCS31.Formatting.EmptyBody">
        <properties>
            <property name="strict" value="true"/>
        </properties>
    </rule>

    <!-- A foreach or match header split over lines takes the layout the other control structures do: the first
         expression on the line after (, and ) { on a line of their own. A foreach's as starts a line too. PER has no
         rule for either, so PERCS31 leaves them alone. -->
    <rule ref="PERCS31.ControlStructures.ControlStructureSpacing">
        <properties>
            <property name="splitForeachAndMatch" value="true"/>
        </properties>
    </rule>

    <rule ref="Generic.CodeAnalysis.AssignmentInCondition"/>

    <!-- A warning for an if whose condition is only true or false -->
    <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>

    <!-- No empty control structure body. An empty catch is left to Squiz.Commenting.EmptyCatchComment, which allows one
         with a comment saying why. -->
    <rule ref="Generic.CodeAnalysis.EmptyStatement">
        <exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedCatch"/>
    </rule>
    <rule ref="Squiz.Commenting.EmptyCatchComment"/>

    <!-- No else or elseif after branches that all exit early -->
    <rule ref="PhpCollective.ControlStructures.UnneededElse"/>

    <!-- No foreach with the same variable as its key and value -->
    <rule ref="Universal.CodeAnalysis.ForeachUniqueAssignment"/>

    <!-- A warning for a for loop with only a condition, which can be a while loop, and for goto -->
    <rule ref="Generic.CodeAnalysis.ForLoopShouldBeWhileLoop"/>
    <rule ref="Generic.PHP.DiscourageGoto"/>

    <rule ref="SlevomatCodingStandard.ControlStructures.DisallowContinueWithoutIntegerOperandInSwitch"/>
    <!-- One space after a language construct such as return, echo or throw, with no line break. The Jumbo version of
         Generic.WhiteSpace.LanguageConstructSpacing, which leaves out new, as PER puts it on its own line before an
         anonymous class's attributes (8), and a yield with no value before ), ] or , -->
    <rule ref="Jumbo.WhiteSpace.LanguageConstructSpacing"/>

    <!-- Replaced by Jumbo.ControlStructures.LanguageConstructWithParentheses, which leaves exit() and die() alone -->
    <rule ref="Jumbo.ControlStructures.LanguageConstructWithParentheses"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.UselessIfConditionWithReturn"/>
    <rule ref="SlevomatCodingStandard.Exceptions.DeadCatch"/>
    <rule ref="SlevomatCodingStandard.Exceptions.RequireNonCapturingCatch"/>

    <!-- A control structure's header on one line if it fits, and split with its condition on its own line if it
         doesn't. Jumbo.Formatting.ExpressionFormat splits the condition itself. -->
    <rule ref="Jumbo.ControlStructures.HeaderLayout">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>

    <!-- A match arm on one line up to its value if it fits, otherwise indented one level past its first line, and no
         comma before its => -->
    <rule ref="Jumbo.ControlStructures.MatchArmWrapIndent">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>

    <!-- An expression on one line if it fits, otherwise split only before its loosest operators. PER allows a split
         before any operator. -->
    <rule ref="Jumbo.Formatting.ExpressionFormat">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
            <property name="reflowStringExpressions" value="true"/>
        </properties>
    </rule>

    <!-- A split statement, function signature or class header on one line if it fits. PER allows the split. -->
    <rule ref="Jumbo.Formatting.RequireSingleLineStatement">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>
    <rule ref="Jumbo.Functions.RequireSingleLineSignature">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>
    <rule ref="Jumbo.Classes.RequireSingleLineClassHeader">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>

    <!-- ====== OPERATORS (6) ====== -->

    <rule ref="SlevomatCodingStandard.Operators.RequireCombinedAssignmentOperator"/>
    <rule ref="SlevomatCodingStandard.Operators.RequireOnlyStandaloneIncrementAndDecrementOperators"/>

    <!-- An increment or decrement operator, not $i += 1 or $i -= 1. NotAllowed and NoBrackets are left out, as
         SlevomatCodingStandard.Operators.RequireOnlyStandaloneIncrementAndDecrementOperators reports those lines. -->
    <rule ref="Squiz.Operators.IncrementDecrementUsage">
        <exclude name="Squiz.Operators.IncrementDecrementUsage.NotAllowed"/>
        <exclude name="Squiz.Operators.IncrementDecrementUsage.NoBrackets"/>
    </rule>

    <!-- No $a = $b = 1: an assignment comes first on its line. FoundInControlStructure is left out, as an assignment in
         a condition is a warning, from Generic.CodeAnalysis.AssignmentInCondition. -->
    <rule ref="Squiz.PHP.DisallowMultipleAssignments">
        <exclude name="Squiz.PHP.DisallowMultipleAssignments.FoundInControlStructure"/>
    </rule>

    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceEqualOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireNullSafeObjectOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireMultiLineTernaryOperator">
        <properties>
            <property name="lineLengthLimit" value="&lineLength;"/>
        </properties>
    </rule>
    <!-- The Jumbo version of RequireShortTernaryOperator, which skips the ? in set(?int $value), as the parent crashes on
         it -->
    <rule ref="Jumbo.ControlStructures.RequireShortTernaryOperator"/>
    <rule ref="SlevomatCodingStandard.ControlStructures.RequireTernaryOperator"/>

    <!-- && and ||, not and and or, which bind more loosely than = -->
    <rule ref="Squiz.Operators.ValidLogicalOperators"/>

    <!-- Parentheses where && and || are mixed -->
    <rule ref="Generic.CodeAnalysis.RequireExplicitBooleanOperatorPrecedence"/>

    <!-- No $a > $b ? true : false, no !!$x, and != rather than <> -->
    <rule ref="SlevomatCodingStandard.ControlStructures.UselessTernaryOperator"/>
    <rule ref="Universal.CodeAnalysis.NoDoubleNegative"/>
    <rule ref="PhpCollective.PHP.NotEqual"/>

    <!-- No whitespace after a prefix unary +, -, !, ~ or @, as well as the reference & that PERCS31 checks -->
    <rule ref="PERCS31.Operators.UnaryOperatorSpacing">
        <properties>
            <property name="checkPlusOperator" value="true"/>
            <property name="checkNegationOperator" value="true"/>
            <property name="checkNotOperator" value="true"/>
            <property name="checkBitwiseNotOperator" value="true"/>
            <property name="checkErrorControlOperator" value="true"/>
        </properties>
    </rule>

    <!-- Exactly one space around operators, including before assignments (no alignment): the codes
         PERCS31.Operators.OperatorSpacing reports more than one space with, which PERCS31 excludes -->
    <rule ref="PERCS31.Operators.OperatorSpacing">
        <properties>
            <property name="ignoreNewlines" value="true"/>
            <property name="ignoreSpacingBeforeAssignments" value="false"/>
            <property name="checkDefaultValues" value="false"/>
        </properties>
    </rule>
    <!-- Exactly one space around a default value's =, which PERCS31 excludes for at least one -->
    <rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpaceBeforeEquals">
        <severity>5</severity>
    </rule>
    <rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpaceAfterEquals">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.Operators.OperatorSpacing.SpacingBefore">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.Operators.OperatorSpacing.SpacingAfter">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.Operators.OperatorSpacing.SpacingBeforeAmp">
        <severity>5</severity>
    </rule>
    <rule ref="PERCS31.Operators.OperatorSpacing.SpacingAfterAmp">
        <severity>5</severity>
    </rule>

    <!-- A line in a control structure's condition indented exactly as needed: once past the ( line for a boolean
         operator, and once past its operand's line for any other operator. PERCS31 allows at least once (5). -->
    <rule ref="PERCS31.Operators.OperatorPlacement">
        <properties>
            <property name="requireExactConditionIndent" value="true"/>
        </properties>
    </rule>

    <!-- ====== CLOSURES (7) ====== -->

    <rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>

    <!-- An arrow function for a closure that only returns -->
    <rule ref="SlevomatCodingStandard.Functions.RequireArrowFunction"/>

    <!-- A warning for a closure over 10 lines of code, and an error over 20 -->
    <rule ref="Universal.FunctionDeclarations.NoLongClosures">
        <properties>
            <property name="recommendedLines" value="10"/>
            <property name="maxLines" value="20"/>
        </properties>
    </rule>

    <!-- ====== ARRAYS (11) ====== -->

    <!-- Arrays: the check PERCS31 leaves out. No mix of keyed and unkeyed values. The spacing around => is left to
         PERCS31.WhiteSpace.ArrowSpacing, which covers every array. -->
    <rule ref="Squiz.Arrays.ArrayDeclaration.KeySpecified">
        <severity>5</severity>
    </rule>
    <rule ref="Squiz.Arrays.ArrayDeclaration.NoKeySpecified">
        <severity>5</severity>
    </rule>

    <!-- An array that starts a split foreach or match header may start a line, as that header's first expression goes
         on the line after its ( in Jumbo. See PERCS31.ControlStructures.ControlStructureSpacing, above. -->
    <rule ref="PERCS31.Arrays.MultiLineArrayLayout">
        <properties>
            <property name="splitForeachAndMatch" value="true"/>
        </properties>
    </rule>

    <!-- Exactly one space around => in every match arm, array and yield, where PERCS31 allows more so arrows can be
         lined up.
         This replaces Squiz.Arrays.ArrayDeclaration's arrow spacing checks, which cover only a single-line array. -->
    <rule ref="PERCS31.WhiteSpace.ArrowSpacing">
        <properties>
            <property name="allowSeveralSpaces" value="false"/>
        </properties>
    </rule>

    <rule ref="SlevomatCodingStandard.Arrays.ArrayAccess"/>
    <rule ref="SlevomatCodingStandard.Arrays.DisallowImplicitArrayCreation"/>
    <rule ref="SlevomatCodingStandard.Arrays.DisallowPartiallyKeyed"/>
    <rule ref="SlevomatCodingStandard.PHP.ShortList"/>

    <!-- No key repeated in an array, where PHP silently keeps the last value -->
    <rule ref="Universal.Arrays.DuplicateArrayKey"/>

    <!-- Multi-line arrays that fit on one line must be written on one line -->
    <rule ref="Jumbo.Arrays.ArrayDeclaration">
        <properties>
            <property name="maxLineLength" value="&lineLength;"/>
        </properties>
    </rule>

    <!-- The comma after a multi-line array's element on the element's last line, replacing Squiz's NoComma, which
         only checks a keyed element and gets a heredoc element wrong -->
    <rule ref="Jumbo.Arrays.ElementComma"/>

    <!-- ====== ATTRIBUTES (12) ====== -->


    <rule ref="SlevomatCodingStandard.Attributes.AttributesOrder">
        <properties>
            <property name="orderAlphabetically" value="true"/>
        </properties>
    </rule>

    <!-- ====== COMMENTS (NOT IN PER) ====== -->

    <!-- One space after //, as in // Text -->
    <rule ref="Squiz.Commenting.InlineComment.NoSpaceBefore"/>
    <rule ref="Squiz.Commenting.InlineComment.SpacingBefore"/>
    <rule ref="Squiz.Commenting.InlineComment.TabBefore"/>

    <!-- // for a comment, not #, except #region and #endregion, which editors fold code on -->
    <rule ref="Jumbo.Commenting.DisallowHashComments"/>

    <!-- One space between code and a // comment after it -->
    <rule ref="Jumbo.Commenting.TrailingComment"/>

    <!-- A block comment's lines indented at least as far as its /*, its */ lined up, and the spaces around one on a
         single line -->
    <rule ref="Jumbo.Commenting.BlockComment"/>

    <!-- Docblock tag names in their usual case, with no aliases, and inline tags as {@name description}, and a
         function's @param and @return tags and every @var checked against the code. Replaces
         SlevomatCodingStandard.Commenting.AnnotationName, which skips block tags in a namespaced file, and
         PhpCollective.Commenting.InlineDocBlock -->
    <rule ref="Jumbo.Commenting.PhpDocTags"/>

    <rule ref="SlevomatCodingStandard.Commenting.DeprecatedAnnotationDeclaration"/>
    <rule ref="SlevomatCodingStandard.Commenting.EmptyComment"/>

    <!-- A docblock's stars lined up, with one space after each -->
    <rule ref="Squiz.Commenting.DocCommentAlignment"/>

    <!-- A doc comment with one tag and no description on one line, and one doc comment per declaration -->
    <rule ref="SlevomatCodingStandard.Commenting.RequireOneLineDocComment"/>
    <rule ref="SlevomatCodingStandard.Commenting.RequireOneDocComment"/>

    <rule ref="SlevomatCodingStandard.Commenting.UselessInheritDocComment"/>

    <!-- A doc comment's layout: these codes by name, so codes added upstream stay out. A one-line doc comment isn't
         checked, a doc comment needn't start with a summary, and an empty one is
         SlevomatCodingStandard.Commenting.EmptyComment's. -->
    <rule ref="Generic.Commenting.DocComment.SpacingAfter"/>
    <rule ref="Generic.Commenting.DocComment.LongNotCapital"/>
    <rule ref="Generic.Commenting.DocComment.ShortNotCapital"/>
    <rule ref="Generic.Commenting.DocComment.SpacingBetween"/>
    <rule ref="Generic.Commenting.DocComment.SpacingBeforeTags"/>
    <rule ref="Generic.Commenting.DocComment.ParamNotFirst"/>
    <rule ref="Generic.Commenting.DocComment.ParamGroup"/>
    <rule ref="Generic.Commenting.DocComment.TagsNotGrouped"/>
    <rule ref="Generic.Commenting.DocComment.SpacingAfterTagGroup"/>

    <!-- /** and */, not /*** or **/, and nothing after the /** of a multi-line doc comment -->
    <rule ref="PhpCollective.Commenting.DocBlockStructure"/>

    <!-- No blank line between a doc comment and its class, interface, trait or function -->
    <rule ref="PhpCollective.WhiteSpace.DocBlockSpacing"/>

    <!-- One space after each comma in a generic doc type, as in array<string, int>, and none inside the brackets -->
    <rule ref="PhpCollective.Commenting.DocBlockTagIterable"/>

    <!-- @return $this, not self or the class's name, where every return is return $this; and no @return description
         that starts with a variable -->
    <rule ref="PhpCollective.Commenting.DocBlockReturnSelf.SelfVsThis"/>
    <rule ref="PhpCollective.Commenting.DocBlockReturnSelf.ClassVsThis"/>
    <rule ref="PhpCollective.Commenting.DocBlockReturnTag"/>

    <!-- An inline @var on an assignment as an assert() after it -->
    <rule ref="SlevomatCodingStandard.PHP.RequireExplicitAssertion"/>

    <!-- ====== STRINGS (NOT IN PER) ====== -->

    <!-- Ensure strings only use double quotes if necessary -->
    <rule ref="Squiz.Strings.DoubleQuoteUsage.NotRequired"/>

    <rule ref="SlevomatCodingStandard.Strings.DisallowVariableParsing"/>

    <!-- Braces around every variable in a string, as in "Hi {$name}". -->
    <rule ref="Jumbo.Strings.RequireBracedVariables"/>

    <!-- No space between <<< and a heredoc's or nowdoc's identifier -->
    <rule ref="Generic.WhiteSpace.HereNowdocIdentifierSpacing"/>

    <!-- ====== VARIABLES (NOT IN PER) ====== -->

    <!-- Variables and properties in lowerCamelCaps -->
    <rule ref="Squiz.NamingConventions.ValidVariableName">
        <exclude name="Squiz.NamingConventions.ValidVariableName.PublicHasUnderscore"/>
        <exclude name="Squiz.NamingConventions.ValidVariableName.PrivateNoUnderscore"/>
    </rule>

    <!-- Leading underscore on a variable or parameter inside a class, which Squiz.NamingConventions.ValidVariableName
         allows there -->
    <rule ref="Jumbo.NamingConventions.ValidVariableName"/>

    <rule ref="SlevomatCodingStandard.Variables.DisallowVariableVariable"/>
    <rule ref="SlevomatCodingStandard.Variables.DuplicateAssignmentToVariable"/>

    <!-- No $_REQUEST, whose contents depend on the request_order and variables_order ini settings -->
    <rule ref="Generic.PHP.DisallowRequestSuperglobal"/>

    <!-- ====== PHPUNIT (NOT IN PER) ====== -->

    <!-- No PHPUnit annotations, which PHPUnit 12 ignores: attributes, and a test prefix in place of @test. setUp() and
         the other hooks protected. -->
    <rule ref="Jumbo.PhpUnit.TestClass"/>

    <!-- assertNull(), assertTrue() and assertFalse(), not assertSame() with null, true or false -->
    <rule ref="PhpCollective.Testing.AssertPrimitives"/>

</ruleset>
