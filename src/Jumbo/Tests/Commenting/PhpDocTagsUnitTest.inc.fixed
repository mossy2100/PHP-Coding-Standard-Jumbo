<?php

namespace Foo;

use Some\Annotation\Group;
use Some\Annotation\Since;

// Correct tags, in a namespaced file.

/**
 * Summary with {@inheritDoc} and {@see Bar::baz()} inline.
 *
 * See @returns here, and {@foo} and { @ids }, aren't tags to check.
 *
 * @param int $a The number.
 * @return int The result.
 * @phpstan-param positive-int $a
 * @property-read int $b
 * @property-write int $c
 * @static
 * @Type("string")
 * @ORM\Column(type="string")
 * @Group
 * @Since 1.0
 */

/** @inheritDoc */

// Casing.

/**
 * @return int
 * @param int $a
 * @inheritDoc
 * @phpstan-param int $a
 * @codeCoverageIgnore
 */

/** @inheritDoc */

// Aliases, in any case.

/**
 * @return int The result.
 * @return int
 * @inheritDoc
 * @inheritDoc
 * @inheritDoc
 * @var int
 * @var int
 * @see https://example.com
 */

// Inline tags: casing and aliases.

/**
 * Summary {@inheritDoc} and {@see Bar} and {@see https://example.com Example} and {@inheritDoc}.
 */

// Inline format.

/**
 * {@inheritDoc}
 * {@inheritDoc} b
 * {@see Bar} c
 * {@see Bar} d
 * Text {@see Bar} more.
 * {@see Bar} e
 * {@see Bar} f
 * {@inheritDoc test} g
 */

// Inline format, then casing.

/**
 * {@inheritDoc}
 * Text {@see Bar}.
 */

// An inline tag split over two lines isn't checked.

/**
 * Text { @see
 * Bar }.
 */
