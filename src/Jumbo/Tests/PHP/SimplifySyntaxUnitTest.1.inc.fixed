<?php

// For loops: allowed.
for ($i = 0; $i < 10; $i++) {
}
for (; $i < 10; $i++) {
}
for (; $a, $b;) {
}

// For loops: reported.
while ($i < 10) {
}
while ($i < 10) {
}
while (true) {
}
while ($i < 10):
endwhile;
for (/* start */; $i < 10;) {
}
for (; /* ever */;) {
}

// isset(): allowed.
$a = isset($a) || isset($b);
$a = !isset($a) && isset($b);
$a = isset($a) && isset($b) === $c;
$a = $c == isset($a) && isset($b);

// isset(): reported.
$a = isset($a, $b);
$a = isset($a, $b, $c, $d);
if (isset($a['x'], $b) || $c) {
}
$a = !isset($a) && isset($b, $c);
$a = isset($a, $b) && isset($c) === $d;
$a = isset($a, $b);
$a = isset($a) /* why */ && isset($b);

// unset(): allowed.
unset($a);
foo();
unset($b);
foo();
unset($a); // Done.
unset($b);
if ($a) unset($a);

// unset(): reported.
unset($a, $b);
foo();
unset($a, $b, $c);
if ($a) unset($a); unset($b, $c);

// Nullsafe $this: allowed, then reported.
$a = $that?->b;
$a = $this->b?->c;
$a = $this->b;
$a = $this->b();

// Binary strings: allowed, then reported.
$a = 'b';
$a = 'abc';
$a = "abc";
$a = <<<EOT
    abc
    EOT;
$a = <<<'EOT'
    abc
    EOT;

// Braces: allowed.
if ($a) {
}
$a = function () {
};
$a->{'b'} = 1;
{
    function bar()
    {
    }
}

// Braces: reported.
    foo();
switch ($a) {
    case 1:
        foo();
        break;
}
foo();

// Return: allowed.
function one()
{
    if ($a) {
        return;
    }

    foo();
}
function two()
{
    return 1;
}

// Return: reported.
function three()
{
    foo();
}
$a = function () {
    foo();
    // Done.
};
function four()
{
    return /* nothing */;
}
